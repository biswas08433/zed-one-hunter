{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "One Hunter",
  "author": "Sourajyoti Biswas",
  "themes": [
    {
      "name": "One Hunter Classic",
      "appearance": "dark",
      "style": {
        "background": "#191d21",
        "surface.background": "#14181b",
        "elevated_surface.background": "#34393E",

        "text": "#E0E0E0",
        "text.muted": "#E0E0E088",
        "text.placeholder": "#45505b",
        "text.disabled": "#45505b",
        "text.accent": "#F4457D",

        "border": "#45505b",
        "border.variant": "#101315",
        "border.focused": "#F4457D",
        "border.selected": "#F4457D",
        "border.transparent": "#00000000",
        "border.disabled": "#45505b",

        "element.background": "#34393E",
        "element.hover": "#E0E0E014",
        "element.active": "#F4457D55",
        "element.selected": "#F4457D55",
        "element.disabled": "#34393E88",

        "ghost_element.background": "#191d21",
        "ghost_element.hover": "#E0E0E014",
        "ghost_element.active": "#F4457D55",
        "ghost_element.selected": "#F4457D55",
        "ghost_element.disabled": "#191d2188",

        "icon": "#E0E0E0",
        "icon.muted": "#45505b",
        "icon.disabled": "#45505b",
        "icon.placeholder": "#45505b",
        "icon.accent": "#F4457D",

        "status_bar.background": "#101315",
        "title_bar.background": "#101315",
        "toolbar.background": "#101315",
        "tab_bar.background": "#101315",
        "tab.active_background": "#1d2226",
        "tab.inactive_background": "#3A434D44",
        "panel.background": "#14181b",
        "panel.focused_border": "#F4457D",

        "scrollbar.thumb.background": "#45505baa",
        "scrollbar.thumb.hover_background": "#F4457D55",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#101315",
        "scrollbar.track.border": "#00000000",

        "editor.background": "#191d21",
        "editor.foreground": "#E0E0E0",
        "editor.gutter.background": "#191d21",
        "editor.line_number": "#45505b",
        "editor.active_line_number": "#E0E0E0",
        "editor.active_line.background": "#191d2122",
        "editor.highlighted_line.background": "#191d2122",
        "editor.indent_guide": "#191d2188",
        "editor.indent_guide_active": "#53A1FA",
        "editor.wrap_guide": "#34393E",
        "editor.active_wrap_guide": "#45505b",
        "editor.document_highlight.read_background": "#53A1FA22",
        "editor.document_highlight.write_background": "#53A1FA22",
        "editor.document_highlight.bracket_background": "#F4457D44",

        "search.match_background": "#53A1FA55",
        "search.active_match_background": "#F4457D55",

        "conflict": "#B267E6",
        "created": "#5BD1B9",
        "created.background": "#5BD1B922",
        "deleted": "#E61F44",
        "deleted.background": "#E61F4422",
        "error": "#E61F44",
        "error.background": "#E61F4422",
        "error.border": "#E61F44",
        "hidden": "#45505b",

        "hint": "#F4457D",
        "hint.background": "#34393E",
        "hint.border": "#45505b",
        "ignored": "#45505b",
        "info": "#B267E6",
        "info.background": "#34393E",
        "info.border": "#45505b",
        "modified": "#F9C35A",
        "modified.background": "#F9C35A22",

        "predictive": "#45505b",
        "renamed": "#53A1FA",
        "success": "#5BD1B9",
        "success.background": "#5BD1B922",
        "unreachable": "#E34234",
        "warning": "#F9C35A",
        "warning.background": "#F9C35A22",
        "warning.border": "#F9C35A",

        "players": [
          { "cursor": "#F4457D", "background": "#F4457D", "selection": "#F4457D3D" },
          { "cursor": "#53A1FA", "background": "#53A1FA", "selection": "#53A1FA3D" },
          { "cursor": "#5BD1B9", "background": "#5BD1B9", "selection": "#5BD1B93D" },
          { "cursor": "#F9C35A", "background": "#F9C35A", "selection": "#F9C35A3D" },
          { "cursor": "#B267E6", "background": "#B267E6", "selection": "#B267E63D" }
        ],

        "terminal.background": "#191d21",
        "terminal.foreground": "#E0E0E0",
        "terminal.ansi.black": "#34393E",
        "terminal.ansi.red": "#E61F44",
        "terminal.ansi.green": "#5BD1B9",
        "terminal.ansi.yellow": "#53A1FA",
        "terminal.ansi.blue": "#53A1FA",
        "terminal.ansi.magenta": "#F4457D",
        "terminal.ansi.cyan": "#B267E6",
        "terminal.ansi.white": "#E0E0E0",
        "terminal.ansi.bright_black": "#45505b",
        "terminal.ansi.bright_red": "#E61F44",
        "terminal.ansi.bright_green": "#B7F0E5",
        "terminal.ansi.bright_yellow": "#A7C7ED",
        "terminal.ansi.bright_blue": "#A7C7ED",
        "terminal.ansi.bright_magenta": "#EE808B",
        "terminal.ansi.bright_cyan": "#D7C9F0",
        "terminal.ansi.bright_white": "#E0E0E0",

        "syntax": {
          "attribute": { "color": "#F9C35A" },
          "boolean": { "color": "#43AAF9" },
          "comment": { "color": "#888888" },
          "comment.doc": { "color": "#888888" },
          "constant": { "color": "#F9C35A" },
          "constructor": { "color": "#53A1FA" },
          "embedded": { "color": "#E0E0E0" },
          "function": { "color": "#43AAF9", "font_weight": "bold" },
          "keyword": { "color": "#F4457D", "font_weight": "bold" },
          "link_text": { "color": "#F4457D" },
          "link_uri": { "color": "#53A1FA", "font_style": "italic" },
          "number": { "color": "#F9C35A" },
          "operator": { "color": "#EFEFEF" },
          "property": { "color": "#E0E0E0" },
          "punctuation": { "color": "#EFEFEF" },
          "punctuation.bracket": { "color": "#EFEFEF" },
          "punctuation.delimiter": { "color": "#EFEFEF" },
          "string": { "color": "#5BD1B9" },
          "string.escape": { "color": "#5BD1B9" },
          "string.regex": { "color": "#5BD1B9" },
          "string.special": { "color": "#5BD1B9" },
          "string.special.symbol": { "color": "#5BD1B9" },
          "tag": { "color": "#F4457D" },
          "text.literal": { "color": "#E0E0E0" },
          "title": { "color": "#53A1FA", "font_weight": "bold" },
          "type": { "color": "#53A1FA" },
          "variable": { "color": "#E0E0E0" },
          "variable.special": { "color": "#43AAF9" }
        }
      }
    }
  ]
}
